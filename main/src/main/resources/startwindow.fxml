<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            fx:controller="project.start.StartWindowPresenter"
            >
    <left>
        <VBox alignment="CENTER" prefHeight="820" prefWidth="600" spacing="6" style="-fx-padding: 20;">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Ustaw parametry symulacji" />
            <HBox alignment="CENTER">
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="LEFT" minWidth="150"/>
                        <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                    </columnConstraints>

                    <children>
                        <!-- mapWidth -->
                        <Label text="Szerokość Mapy:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <Spinner fx:id="mapWidthSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <!-- mapHeight -->
                        <Label text="Wysokość Mapy:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <Spinner fx:id="mapHeightSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <!-- startGrassCount -->
                        <Label text="Początkowa liczba traw:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <Spinner fx:id="startGrassSpinner" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                        <!-- grassEnergy -->
                        <Label text="Energia trawy:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                        <Spinner fx:id="grassEnergySpinner" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                        <!-- dailyGrassGrowth -->
                        <Label text="Codzienny wzrost trawy:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                        <Spinner fx:id="dailyGrassGrowthSpinner" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                        <!-- maleNumber -->
                        <Label text="Początkowa liczba męskich zwierząt:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                        <Spinner fx:id="maleNumberSpinner" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                        <!-- femaleNumber -->
                        <Label text="Początkowa liczba żeńskich zwierząt:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                        <Spinner fx:id="femaleNumberSpinner" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                        <!-- startEnergy -->
                        <Label text="Początkowa energia zwierząt:" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                        <Spinner fx:id="startEnergySpinner" GridPane.rowIndex="7" GridPane.columnIndex="1" />

                        <!-- reproductionEnergy -->
                        <Label text="Energia potrzebna do rozmnażania:" GridPane.rowIndex="8" GridPane.columnIndex="0" />
                        <Spinner fx:id="reproductionEnergySpinner" GridPane.rowIndex="8" GridPane.columnIndex="1" />

                        <!-- reproductionCost -->
                        <Label text="Koszt rozmnażania:" GridPane.rowIndex="9" GridPane.columnIndex="0" />
                        <Spinner fx:id="reproductionCostSpinner" GridPane.rowIndex="9" GridPane.columnIndex="1" />

                        <!-- habsburgEnergyLoss -->
                        <Label text="Strata energii bliskiego spokrewnienia:" GridPane.rowIndex="10" GridPane.columnIndex="0" />
                        <Spinner fx:id="habsburgEnergyLossSpinner" GridPane.rowIndex="10" GridPane.columnIndex="1" />

                        <!-- moveCost -->
                        <Label text="Koszt Ruchu:" GridPane.rowIndex="11" GridPane.columnIndex="0" />
                        <Spinner fx:id="moveCostSpinner" GridPane.rowIndex="11" GridPane.columnIndex="1" />

                        <!-- minMutations -->
                        <Label text="Minimalna liczba mutacji:" GridPane.rowIndex="12" GridPane.columnIndex="0" />
                        <Spinner fx:id="minMutationsSpinner" GridPane.rowIndex="12" GridPane.columnIndex="1" />

                        <!-- maxMutations -->
                        <Label text="Maksymalna liczba mutacji:" GridPane.rowIndex="13" GridPane.columnIndex="0" />
                        <Spinner fx:id="maxMutationsSpinner" GridPane.rowIndex="13" GridPane.columnIndex="1" />

                        <!-- genomeLength -->
                        <Label text="Długość genomu:" GridPane.rowIndex="14" GridPane.columnIndex="0" />
                        <Spinner fx:id="genomeLengthSpinner" GridPane.rowIndex="14" GridPane.columnIndex="1" />

                        <!-- dayDurationMs -->
                        <Label text="Czas trwania dnia (ms):" GridPane.rowIndex="15" GridPane.columnIndex="0" />
                        <Spinner fx:id="dayDurationSpinner" GridPane.rowIndex="15" GridPane.columnIndex="1" />

                        <!-- CSV Save -->
                        <Label text="Zapisać do CSV?" GridPane.rowIndex="16" GridPane.columnIndex="0" />
                        <CheckBox fx:id="csvSaveCheckBox" GridPane.rowIndex="16" GridPane.columnIndex="1" />
                        <Label text="Zapis konfiguracji do pliku:" GridPane.rowIndex="17" GridPane.columnIndex="0" />
                        <HBox spacing="5" GridPane.rowIndex="17" GridPane.columnIndex="1">
                            <children>
                                <TextField fx:id="filePathField" promptText="Ścieżka do pliku konfiguracji" />
                                <Button fx:id="fileExplorerButton" text="Przeglądaj" />
                            </children>
                        </HBox>
                    </children>
                </GridPane>
            </HBox>

            <!-- Przyciski Start i Cancel -->
            <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20 0 0 0;">
                <children>
                    <Button fx:id="saveButton" text="Zapisz Konfigurację" />
                    <Button fx:id="loadButton" text="Wczytaj Konfigurację" />
                    <Button fx:id="startButton" text="Rozpocznij Symulację" />
                </children>
            </HBox>
        </VBox>
    </left>
    <right>
        <VBox alignment="CENTER" prefHeight="520" prefWidth="300" spacing="6" style="-fx-padding: 20;">
                <Label text="Presety" style="-fx-font-weight: bold; -fx-font-size: 18;" />
                
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="1." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="1" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="1" />
                </HBox>
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="2." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="2" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="2" />
                </HBox>
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="3." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="3" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="3" />
                </HBox>
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="4." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="4" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="4" />
                </HBox>
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="5." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="5" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="5" />
                </HBox>
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="6." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="6" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="6" />
                </HBox>
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="7." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="7" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="7" />
                </HBox>
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                    <Label text="8." prefWidth="20" />
                    <Button text="Zapisz" onAction="#onSavePreset" userData="8" />
                    <Button text="Wczytaj" onAction="#onLoadPreset" userData="8" />
                </HBox>
            </VBox>
    </right>
</BorderPane>
